#!/usr/bin/env python3
"""
bin/apply-config
Reads deps.yaml and writes values into service .dev.env files.
Safe to re-run — existing keys are updated in-place; missing keys are appended.

Usage:
    make apply-config        # via Makefile target
    bin/apply-config         # direct
"""

import json
import re
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit("Error: PyYAML not installed. Run: pip install pyyaml")

REPO = Path(__file__).resolve().parent.parent

# ── helpers ───────────────────────────────────────────────────────────────────

def log_section(name: str) -> None:
    print(f"\n── {name} " + "─" * max(0, 44 - len(name)))

def get(obj, *keys, default=None):
    """Navigate a nested dict safely; return default when any key is absent."""
    for k in keys:
        if not isinstance(obj, dict) or k not in obj:
            return default
        obj = obj[k]
    return obj

def configured(value) -> bool:
    return value is not None and str(value).strip() != ""

def set_env(rel_path: str, key: str, value) -> None:
    """
    Write KEY=value into a service env file.
    - If the key already exists: replaces the line in-place.
    - If the key is absent: appends it.
    - Skips silently when value is None/empty or the file doesn't exist.
    """
    if value is None or str(value).strip() == "":
        return
    path = REPO / rel_path
    if not path.exists():
        return
    val_str = str(value).lower() if isinstance(value, bool) else str(value)
    content = path.read_text()
    pattern = re.compile(rf'^{re.escape(key)}=.*', re.MULTILINE)
    if pattern.search(content):
        content = pattern.sub(f"{key}={val_str}", content)
    else:
        content = content.rstrip("\n") + f"\n{key}={val_str}\n"
    path.write_text(content)
    display = val_str if len(val_str) <= 32 else val_str[:29] + "..."
    print(f"    {rel_path}  →  {key}={display}")

def apply_flag_to_all_dev_envs(key: str, value) -> None:
    """
    Apply KEY=value to every .dev.env / dev.env in the repo that already declares
    that key. Used for global flags like INSTRUMENTATION_ENABLED.
    """
    if value is None:
        return
    for path in sorted(REPO.rglob("*.env")):
        rel = str(path.relative_to(REPO))
        if any(skip in rel for skip in ("vendor", ".test.env", ".local.env")):
            continue
        if not (rel.endswith(".dev.env") or rel.endswith("dev.env")):
            continue
        try:
            content = path.read_text()
        except OSError:
            continue
        if re.search(rf"^{key}=", content, re.MULTILINE):
            set_env(rel, key, value)

# ── service env file paths ────────────────────────────────────────────────────

LITELLM       = "core-services/deps-litellm/etc/litellm/.dev.env"
OCR_GW        = "core-services/deps-ocr-gateway/etc/deps-ocr-api-gateway/env/dev.env"
PARSING       = "core-services/deps-parsing/etc/parsing/env/.dev.env"
AI_FUSION     = "feature-services/deps-ai-fusion/etc/ai-fusion/env/.dev.env"
META_AGENT    = "feature-services/deps-meta-agent/etc/meta-agent/env/.dev.env"
FILE_STORAGE  = "core-services/deps-file-storage/etc/deps-file-storage/env/.dev.env"
CNE           = "feature-services/deps-cloud-native-extraction/etc/cloud-native-extraction/env/.dev.env"
OUTPUT_EXPORTING = "feature-services/deps-output-exporting/etc/output-exporting/env/.dev.env"
IMAGE_PREPROCESS = "feature-services/deps-image-preprocess/etc/deps-image-preprocess/env/.dev.env"
IAM           = "core-services/deps-iam/etc/api/env/.dev.env"
FRONTEND      = "core-services/deps-frontend/.env"
NGINX         = "core-services/deps-nginx/.env"

STORAGE_FILES = [
    FILE_STORAGE,
    PARSING,
    "feature-services/deps-classification/etc/classification/env/.dev.env",
    "feature-services/deps-file/etc/file/env/.dev.env",
]

