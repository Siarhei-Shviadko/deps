# ── main ──────────────────────────────────────────────────────────────────────

def main() -> None:
    config_path = REPO / "deps.yaml"
    if not config_path.exists():
        sys.exit(
            f"\nError: {config_path} not found.\n"
            "Create it first:\n"
            "  make setup-credentials    (interactive wizard)\n"
            "  cp deps.yaml.example deps.yaml  (then edit manually)\n"
        )

    cfg = yaml.safe_load(config_path.read_text()) or {}
    print(f"Applying {config_path.name} …")

    # ── LiteLLM ───────────────────────────────────────────────────────────────
    log_section("LiteLLM")
    lm = get(cfg, "litellm") or {}
    master_key = get(lm, "master_key")
    set_env(LITELLM,    "LITELLM_MASTER_KEY", master_key)
    set_env(LITELLM,    "LITELLM_SALT_KEY",   get(lm, "salt_key"))
    # Sync the proxy key into services that connect to it
    set_env(AI_FUSION,  "LITELLM_API_KEY", master_key)
    set_env(META_AGENT, "LITELLM_API_KEY", master_key)

    # ── OCR ───────────────────────────────────────────────────────────────────
    log_section("OCR")
    ocr = get(cfg, "ocr") or {}

    # Tesseract is always on — built-in, no credentials required.
    set_env(OCR_GW, "TESSERACT_ENABLED", True)

    afr = get(ocr, "azure_form_recognizer") or {}
    set_env(OCR_GW,  "AZURE_FORM_RECOGNIZER_ENABLED",  get(afr, "enabled"))
    set_env(OCR_GW,  "AZURE_FORM_RECOGNIZER_API_URL",  get(afr, "api_url"))
    set_env(OCR_GW,  "AZURE_FORM_RECOGNIZER_API_KEY",  get(afr, "api_key"))
    set_env(PARSING, "AZURE_FORM_RECOGNIZER_API_URL",  get(afr, "api_url"))
    set_env(PARSING, "AZURE_FORM_RECOGNIZER_API_KEY",  get(afr, "api_key"))
    set_env(PARSING, "AZURE_PARSING_STRATEGY",         get(afr, "parsing_strategy"))

    textract = get(ocr, "aws_textract") or {}
    set_env(OCR_GW,  "AWS_TEXTRACT_ENABLED",          get(textract, "enabled"))
    set_env(OCR_GW,  "AWS_REGION_NAME",               get(textract, "region"))
    set_env(OCR_GW,  "AWS_ACCESS_KEY_ID",             get(textract, "access_key_id"))
    set_env(OCR_GW,  "AWS_SECRET_ACCESS_KEY",         get(textract, "secret_access_key"))
    set_env(PARSING, "AWS_TEXTRACT_REGION_NAME",      get(textract, "region"))
    set_env(PARSING, "AWS_TEXTRACT_ACCESS_KEY_ID",    get(textract, "access_key_id"))
    set_env(PARSING, "AWS_TEXTRACT_SECRET_ACCESS_KEY", get(textract, "secret_access_key"))
    set_env(PARSING, "AWS_TEXTRACT_PARSING_STRATEGY", get(textract, "parsing_strategy"))
    # deps-parsing uploads documents to S3 so AWS Textract can read them.
    # These are independent of storage.aws (file-storage can still be local MinIO).
    set_env(PARSING, "AWS_ACCESS_KEY_ID",             get(textract, "access_key_id"))
    set_env(PARSING, "AWS_SECRET_ACCESS_KEY",         get(textract, "secret_access_key"))
    set_env(PARSING, "AWS_REGION",                    get(textract, "region"))
    set_env(PARSING, "S3_BUCKET_NAME",                get(textract, "s3_bucket_name"))
    set_env(PARSING, "S3_ENDPOINT_URL",               get(textract, "s3_endpoint_url"))
    if get(textract, "enabled"):
        set_env(PARSING, "AWS_EC2_METADATA_DISABLED", True)

    gcp_vision = get(ocr, "gcp_vision") or {}
    set_env(OCR_GW, "GCP_VISION_ENABLED",  get(gcp_vision, "enabled"))
    set_env(OCR_GW, "GCP_VISION_AUTH_KEY", get(gcp_vision, "auth_key"))

    # ── Parsing ───────────────────────────────────────────────────────────────
    log_section("Parsing")
    parsing_cfg = get(cfg, "parsing") or {}
    set_env(PARSING, "IMG_ANNOTATION_LLM", get(parsing_cfg, "img_annotation_llm"))

    gcp_docai = get(parsing_cfg, "gcp_docai") or {}
    set_env(PARSING, "GCP_DOCAI_ACCOUNT_INFO_JSON",             get(gcp_docai, "account_info_json"))
    set_env(PARSING, "GCP_DOCAI_PROJECT_ID",                    get(gcp_docai, "project_id"))
    set_env(PARSING, "GCP_DOCAI_LOCATION",                      get(gcp_docai, "location"))
    set_env(PARSING, "GCP_DOCAI_FORM_RECOGNITION_PROCESSOR_ID", get(gcp_docai, "processor_id"))

    cne = get(parsing_cfg, "cloud_native_extraction") or {}
    set_env(CNE, "AZURE_VAULT_URL",     get(cne, "azure_vault_url"))
    set_env(CNE, "AZURE_CLIENT_ID",     get(cne, "client_id"))
    set_env(CNE, "AZURE_TENANT_ID",     get(cne, "tenant_id"))
    set_env(CNE, "AZURE_CLIENT_SECRET", get(cne, "client_secret"))

    # ── LLM providers ─────────────────────────────────────────────────────────
    log_section("LLM providers")
    llm = get(cfg, "llm") or {}

    dial = get(llm, "epam_dial") or {}
    set_env(LITELLM,    "DIAL_API_BASE",          get(dial, "api_base"))
    set_env(LITELLM,    "DIAL_API_KEY",           get(dial, "api_key"))
    set_env(LITELLM,    "DIAL_API_VERSION",       get(dial, "api_version"))
    set_env(AI_FUSION,  "EPAM_DIAL_ENDPOINT",     get(dial, "api_base"))
    set_env(AI_FUSION,  "EPAM_DIAL_API_KEY",      get(dial, "api_key"))
    set_env(AI_FUSION,  "EPAM_DIAL_API_VERSION",  get(dial, "api_version"))
    set_env(META_AGENT, "EPAM_DIAL_ENDPOINT",     get(dial, "api_base"))
    set_env(META_AGENT, "EPAM_DIAL_API_KEY",      get(dial, "api_key"))
    set_env(META_AGENT, "EPAM_DIAL_API_VERSION",  get(dial, "api_version"))

    azure_oai = get(llm, "azure_openai") or {}
    set_env(LITELLM,    "AZURE_API_BASE",       get(azure_oai, "api_endpoint"))
    set_env(LITELLM,    "AZURE_API_KEY",        get(azure_oai, "api_key"))
    set_env(AI_FUSION,  "AZURE_API_ENDPOINT",   get(azure_oai, "api_endpoint"))
    set_env(AI_FUSION,  "AZURE_API_KEY",        get(azure_oai, "api_key"))
    set_env(AI_FUSION,  "AZURE_API_VERSION",    get(azure_oai, "api_version"))
    set_env(META_AGENT, "AZURE_API_ENDPOINT",   get(azure_oai, "api_endpoint"))
    set_env(META_AGENT, "AZURE_API_KEY",        get(azure_oai, "api_key"))
    set_env(META_AGENT, "AZURE_API_VERSION",    get(azure_oai, "api_version"))

    openai = get(llm, "openai") or {}
    set_env(AI_FUSION,  "OPENAI_API_KEY", get(openai, "api_key"))
    set_env(META_AGENT, "OPENAI_API_KEY", get(openai, "api_key"))

    bedrock = get(llm, "aws_bedrock") or {}
    set_env(LITELLM,    "AWS_REGION_NAME",                 get(bedrock, "region"))
    set_env(LITELLM,    "AWS_ACCESS_KEY_ID",               get(bedrock, "access_key_id"))
    set_env(LITELLM,    "AWS_SECRET_ACCESS_KEY",           get(bedrock, "secret_access_key"))
    set_env(AI_FUSION,  "AWS_BEDROCK_REGION",              get(bedrock, "region"))
    set_env(AI_FUSION,  "AWS_BEDROCK_ACCESS_KEY_ID",       get(bedrock, "access_key_id"))
    set_env(AI_FUSION,  "AWS_BEDROCK_SECRET_ACCESS_KEY",   get(bedrock, "secret_access_key"))
    set_env(META_AGENT, "AWS_REGION",                      get(bedrock, "region"))
    set_env(META_AGENT, "AWS_ACCESS_KEY_ID",               get(bedrock, "access_key_id"))
    set_env(META_AGENT, "AWS_SECRET_ACCESS_KEY",           get(bedrock, "secret_access_key"))

    gemini = get(llm, "google_gemini") or {}
    set_env(LITELLM,    "GOOGLE_API_KEY", get(gemini, "api_key"))
    set_env(AI_FUSION,  "GOOGLE_API_KEY", get(gemini, "api_key"))
    set_env(META_AGENT, "GOOGLE_API_KEY", get(gemini, "api_key"))

    deepseek = get(llm, "deepseek") or {}
    set_env(LITELLM, "DEEPSEEK_API_KEY", get(deepseek, "api_key"))

    groq = get(llm, "groq") or {}
    set_env(LITELLM, "GROQ_API_KEY", get(groq, "api_key"))

    providers: list[str] = []
    if configured(get(dial, "api_key")):
        providers.append("dial")
    if configured(get(azure_oai, "api_key")):
        providers.append("azure")
    if configured(get(bedrock, "access_key_id")) and configured(get(bedrock, "secret_access_key")):
        providers.append("aws-bedrock")
    if configured(get(gemini, "api_key")):
        providers.append("google")
    set_env(AI_FUSION, "SUPPORTED_PROVIDERS", f"'{json.dumps(providers)}'")

    # ── Object storage ────────────────────────────────────────────────────────
    log_section("Object storage")
    storage = get(cfg, "storage") or {}

    azure_blob = get(storage, "azure") or {}
    for f in STORAGE_FILES:
        set_env(f, "AZURE_CONNECTION_STRING", get(azure_blob, "connection_string"))
        set_env(f, "AZURE_CONTAINER_NAME",    get(azure_blob, "container_name"))

    aws_s3 = get(storage, "aws") or {}
    for f in STORAGE_FILES:
        if f == PARSING and get(textract, "s3_bucket_name"):
            # Textract S3 already written onto deps-parsing; do not overwrite with storage.aws.
            continue
        set_env(f, "AWS_ACCESS_KEY_ID",     get(aws_s3, "access_key_id"))
        set_env(f, "AWS_SECRET_ACCESS_KEY", get(aws_s3, "secret_access_key"))
        set_env(f, "AWS_REGION",            get(aws_s3, "region"))
        set_env(f, "S3_ENDPOINT_URL",       get(aws_s3, "endpoint_url"))
        set_env(f, "S3_BUCKET_NAME",        get(aws_s3, "bucket_name"))

    gcp_gcs = get(storage, "gcp") or {}
    for f in STORAGE_FILES:
        set_env(f, "GCP_BLOB_STORAGE_AUTH_KEY",    get(gcp_gcs, "auth_key"))
        set_env(f, "GCP_BLOB_STORAGE_BUCKET_NAME", get(gcp_gcs, "bucket_name"))

    # ── SMTP ──────────────────────────────────────────────────────────────────
    log_section("SMTP")
    smtp = get(cfg, "smtp") or {}
    set_env(IAM, "SMTP_HOST",     get(smtp, "host"))
    set_env(IAM, "SMTP_PORT",     get(smtp, "port"))
    set_env(IAM, "SMTP_LOGIN",    get(smtp, "login"))
    set_env(IAM, "SMTP_PASSWORD", get(smtp, "password"))

    # ── Frontend ──────────────────────────────────────────────────────────────
    log_section("Frontend")
    fe = get(cfg, "frontend") or {}
    base_url = (get(fe, "base_url") or "http://localhost:8000").rstrip("/")

    # Step 1: apply defaults (FEATURE_* flags, AUTH_TYPE, misc)
    for key, value in FRONTEND_DEFAULTS.items():
        set_env(FRONTEND, key, value)

    # Step 2: generate service URLs from base_url
    FRONTEND_URLS = {
        "BASE_API_URL":          "/api",
        "BACKEND_URL":           "/api/document",
        "TABLES_URL":            "/api/tables",
        "OCR_URL":               "/api/ocr",
        "PREPROCESS_URL":        "/api/preprocess",
        "IAM_URL":               "/api/iam",
        "FILE_STORAGE_URL":      "/api/storage",
        "OMR_URL":               "/api/omr",
        "TEMPLATE_URL":          "/api/template",
        "WORKFLOW_MANAGER_URL":  "/api/workflow-manager",
        "API_GATEWAY_URL":       "/api/deps",
        "OUTPUT_EXPORTING_URL":  "/api/output-exporting",
        "IMAGE_PREPROCESS_URL":  "/api/image-preprocess",
        "DOCUMENT_TYPE_URL":     "/api/document-type",
        "EXTRACTION_URL":        "/api/extraction",
        "UNIFIER_URL":           "/api/unifier",
        "RESULT_EXPORTING_URL":  "/api/result-exporting",
        "PROTOTYPE_URL":         "/api/prototype",
        "NER_URL":               "/api/ner",
        "PROMPTER_URL":          "/api/prompter",
        "AGENTIC_AI_URL":        "/api/agentic-ai",
        "COMPARISON_URL":        "/api/comparison",
        "MFE_COMPARISON_URL":    "/api/comparison",
    }
    for env_var, path_suffix in FRONTEND_URLS.items():
        set_env(FRONTEND, env_var, base_url + path_suffix)

    # Step 3: apply user credentials / overrides from deps.yaml
    gdrive = get(fe, "google_drive") or {}
    set_env(FRONTEND, "GOOGLE_DRIVE_API_KEY",               get(gdrive, "api_key"))
    set_env(FRONTEND, "GOOGLE_DRIVE_CLIENT_ID",             get(gdrive, "client_id"))
    set_env(FRONTEND, "GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL", get(gdrive, "service_account_email"))
    onedrive = get(fe, "one_drive") or {}
    set_env(FRONTEND, "ONE_DRIVE_CLIENT_ID",             get(onedrive, "client_id"))
    set_env(FRONTEND, "ONE_DRIVE_SERVICE_ACCOUNT_EMAIL", get(onedrive, "service_account_email"))

    # Step 4: OIDC auth settings (only active when feature_flags.auth_enabled: true)
    auth_fe = get(cfg, "auth") or {}
    set_env(FRONTEND, "AUTH_BASE_URL",  get(auth_fe, "base_url"))
    set_env(FRONTEND, "AUTH_REALM",     get(auth_fe, "realm"))
    set_env(FRONTEND, "AUTH_CLIENT_ID", get(auth_fe, "client_id"))
    set_env(FRONTEND, "AUTH_SCOPE",     get(auth_fe, "scope"))

    # Step 5: Elastic APM
    apm = get(cfg, "elastic_apm") or {}
    set_env(FRONTEND, "ELASTIC_SERVER_URL",   get(apm, "server_url"))
    set_env(FRONTEND, "ELASTIC_ENVIRONMENT",  get(apm, "environment"))
    set_env(FRONTEND, "ELASTIC_SERVICE_NAME", get(apm, "service_name"))
    set_env(FRONTEND, "ELASTIC_PROJECT_CODE", get(apm, "project_code"))

    # ── Auth (nginx) ──────────────────────────────────────────────────────────
    log_section("Auth")
    auth = get(cfg, "auth") or {}
    set_env(NGINX, "UPSTREAM_AUTH_URL", get(auth, "upstream_auth_url"))
    set_env(NGINX, "AUTH_URI",          get(auth, "auth_uri"))

    # ── Feature flags ─────────────────────────────────────────────────────────
    log_section("Feature flags")
    flags = get(cfg, "feature_flags") or {}

    # auth_enabled → deps-iam only
    set_env(IAM, "AUTH_ENABLED", get(flags, "auth_enabled"))

    # deps-image-preprocess requires auth on for local / open-source
    set_env(IMAGE_PREPROCESS, "AUTH_ENABLED", True)

    # auth_verify_ssl → all services that declare it (controls SSL for auth token calls)
    val = get(flags, "auth_verify_ssl")
    if val is not None:
        apply_flag_to_all_dev_envs("AUTH_VERIFY_SSL", val)

    # instrumentation_enabled → all services that declare it
    val = get(flags, "instrumentation_enabled")
    if val is not None:
        apply_flag_to_all_dev_envs("INSTRUMENTATION_ENABLED", val)

    # Parsing-specific flags
    set_env(PARSING, "SEMANTIC_LAYOUT_ENABLED", get(flags, "semantic_layout_enabled"))
    set_env(PARSING, "MERGE_TABLES_ENABLED",    get(flags, "merge_tables_enabled"))

    # LiteLLM proxy routing in ai-fusion
    set_env(AI_FUSION, "LITELLM_ENABLED", get(flags, "litellm_enabled"))

    # Output-exporting validation pipeline (defaults on for local / open-source)
    new_validation = get(flags, "new_validation_process")
    set_env(OUTPUT_EXPORTING, "NEW_VALIDATION_PROCESS", True if new_validation is None else new_validation)

    # Frontend GenAI key-value fields tab — override FRONTEND_DEFAULTS when set in deps.yaml
    gen_ai_kv = get(flags, "gen_ai_key_value_fields")
    if gen_ai_kv is not None:
        set_env(FRONTEND, "FEATURE_GEN_AI_KEY_VALUE_FIELDS", gen_ai_kv)

    print("\n✓ Done.")

if __name__ == "__main__":
    main()
