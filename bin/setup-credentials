#!/usr/bin/env bash
# First-time setup wizard: generates deps.yaml.
# Afterwards, apply the config at any time with: make apply-config
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG="$REPO_ROOT/deps.yaml"
EXAMPLE="$REPO_ROOT/deps.yaml.example"

# ── Colours ───────────────────────────────────────────────────────────────────
BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
DIM='\033[2m'
RESET='\033[0m'

section() {
    echo
    echo -e "${BOLD}${CYAN}══════════════════════════════════════════${RESET}"
    echo -e "${BOLD}${CYAN}  $1${RESET}"
    echo -e "${BOLD}${CYAN}══════════════════════════════════════════${RESET}"
}

prompt_value() {
    local _var="$1" _label="$2" _default="${3:-}"
    local _hint=""
    [[ -n "$_default" ]] && _hint=" ${DIM}[${_default}]${RESET}"
    echo -ne "  ${_label}${_hint}: "
    read -r _input
    printf -v "$_var" '%s' "${_input:-$_default}"
}

prompt_secret() {
    local _var="$1" _label="$2"
    echo -ne "  ${_label} ${DIM}(hidden)${RESET}: "
    read -rs _input; echo
    printf -v "$_var" '%s' "$_input"
}

ask_yesno() {
    local _var="$1" _q="$2"
    echo -ne "  ${_q} ${DIM}[y/N]${RESET}: "
    read -r _ans
    printf -v "$_var" '%s' "$( [[ "${_ans,,}" == y* ]] && echo y || echo n )"
}

ask_choice() {
    local _var="$1" _label="$2"; shift 2
    local _opts=("$@")
    echo "  ${_label}:"
    for i in "${!_opts[@]}"; do echo "    $((i+1))) ${_opts[$i]}"; done
    while true; do
        echo -ne "  Enter number: "; read -r _n
        if [[ "$_n" =~ ^[0-9]+$ ]] && (( _n >= 1 && _n <= ${#_opts[@]} )); then
            printf -v "$_var" '%s' "${_opts[$((_n-1))]}"; break
        fi
        echo -e "  ${YELLOW}Please enter 1–${#_opts[@]}.${RESET}"
    done
}

ask_multiselect() {
    local _var="$1" _label="$2"; shift 2
    local _opts=("$@")
    echo -e "  ${_label} ${DIM}(space-separated numbers, e.g. \"1 3\")${RESET}:"
    for i in "${!_opts[@]}"; do echo "    $((i+1))) ${_opts[$i]}"; done
    echo -ne "  Your choices: "; read -r _choices
    local _result=""
    for _n in $_choices; do
        [[ "$_n" =~ ^[0-9]+$ ]] && (( _n >= 1 && _n <= ${#_opts[@]} )) &&
            _result+="${_opts[$((_n-1))]} "
    done
    printf -v "$_var" '%s' "${_result% }"
}

contains() { [[ " $2 " == *" $1 "* ]]; }

# Emit a YAML single-quoted scalar, escaping embedded single quotes.
yq() { local v="$1"; [[ -z "$v" ]] && echo '""' || echo "'${v//\'/\'\'}'"; }
# Emit a YAML boolean.
yb() { [[ "${1,,}" == "true" || "${1,,}" == "y" ]] && echo "true" || echo "false"; }

# ── Preflight ─────────────────────────────────────────────────────────────────

echo
echo -e "${BOLD}DEPS — Credentials Setup${RESET}"
echo

if [[ -f "$CONFIG" ]]; then
    echo -e "${YELLOW}deps.yaml already exists.${RESET}"
    ask_yesno OVERWRITE "Overwrite it with a fresh configuration?"
    if [[ "$OVERWRITE" == "n" ]]; then
        echo -e "${DIM}Keeping existing deps.yaml.${RESET}"
        echo -e "${DIM}Run 'make apply-config' to re-apply it to service env files.${RESET}"
        exit 0
    fi
fi

# ── Mode selection ─────────────────────────────────────────────────────────────

section "Setup mode"
echo "  How would you like to fill in the configuration?"
echo
echo "    1) Interactive — guided prompts write deps.yaml automatically"
echo "    2) Manual      — copies deps.yaml.example for you to edit, then optionally"
echo "                     opens it in your editor"
echo
echo -ne "  Choice [1/2]: "; read -r SETUP_MODE

if [[ "$SETUP_MODE" == "2" ]]; then
    cp "$EXAMPLE" "$CONFIG"
    echo
    echo -e "${GREEN}✓ deps.yaml created from template.${RESET}"
    echo -e "${DIM}  Edit deps.yaml, then run: make apply-config${RESET}"
    # Offer to open in editor
    CHOSEN_EDITOR=""
    for e in "${EDITOR:-}" nano vim vi; do
        [[ -n "$e" ]] && command -v "$e" &>/dev/null && { CHOSEN_EDITOR="$e"; break; }
    done
    if [[ -n "$CHOSEN_EDITOR" ]]; then
        ask_yesno OPEN_NOW "Open deps.yaml in $CHOSEN_EDITOR now?"
        [[ "$OPEN_NOW" == "y" ]] && "$CHOSEN_EDITOR" "$CONFIG"
    fi
    exit 0
fi

# ── Interactive mode ──────────────────────────────────────────────────────────

# 1. LiteLLM
section "1 / 7 — LiteLLM internal keys"
echo -e "  ${DIM}Secure the LiteLLM proxy. Change from defaults before any public deployment.${RESET}"
echo
prompt_value LITELLM_MASTER_KEY "Master key (must start with sk-)" "sk-change-me"
prompt_value LITELLM_SALT_KEY   "Salt key"                         "deps-salt-change-me"

# 2. OCR
section "2 / 7 — OCR engines"
echo -e "  ${DIM}Tesseract is always enabled (built-in, no key needed).${RESET}"
echo -e "  ${DIM}Select extra OCR engines you have access to.${RESET}"
echo
ask_multiselect OCR_PROVIDERS \
    "Enable extra OCR engines" \
    "Azure Form Recognizer" \
    "AWS Textract" \
    "GCP Vision"

AFR_URL="" AFR_KEY="" AFR_STRATEGY="by_document"
TEXTRACT_REGION="eu-central-1" TEXTRACT_KEY_ID="" TEXTRACT_SECRET="" TEXTRACT_STRATEGY="by_document"
TEXTRACT_S3_BUCKET="" TEXTRACT_S3_ENDPOINT=""
GCP_VISION_KEY=""

if contains "Azure Form Recognizer" "$OCR_PROVIDERS"; then
    echo; echo -e "  ${BOLD}Azure Form Recognizer${RESET}"
    prompt_value  AFR_URL      "  Endpoint URL" ""
    prompt_secret AFR_KEY      "  API key"
    ask_choice    AFR_STRATEGY "  Parsing strategy" "by_document" "by_page"
fi
if contains "AWS Textract" "$OCR_PROVIDERS"; then
    echo; echo -e "  ${BOLD}AWS Textract${RESET}"
    prompt_value  TEXTRACT_REGION    "  AWS region"   "eu-central-1"
    prompt_value  TEXTRACT_KEY_ID    "  Access key ID" ""
    prompt_secret TEXTRACT_SECRET    "  Secret access key"
    ask_choice    TEXTRACT_STRATEGY  "  Parsing strategy" "by_document" "by_page"
    echo
    echo -e "  ${DIM}deps-parsing uploads documents to S3 so AWS Textract can read them.${RESET}"
    echo -e "  ${DIM}Use a real AWS S3 bucket (not local MinIO). The Textract keys above are reused.${RESET}"
    prompt_value  TEXTRACT_S3_BUCKET   "  S3 bucket name" ""
    prompt_value  TEXTRACT_S3_ENDPOINT "  S3 endpoint URL" "https://s3.${TEXTRACT_REGION}.amazonaws.com"
fi
if contains "GCP Vision" "$OCR_PROVIDERS"; then
    echo; echo -e "  ${BOLD}GCP Vision${RESET}"
    prompt_secret GCP_VISION_KEY "  Service account auth key (JSON)"
fi

# 3. Parsing
section "3 / 7 — Document parsing"
echo -e "  ${DIM}Advanced parsing backends and image annotation.${RESET}"
echo

GCP_DOCAI_JSON="" GCP_DOCAI_PROJECT="" GCP_DOCAI_LOCATION="eu" GCP_DOCAI_PROCESSOR=""
ask_yesno USE_GCP_DOCAI "Configure GCP Document AI?"
if [[ "$USE_GCP_DOCAI" == "y" ]]; then
    prompt_secret GCP_DOCAI_JSON      "  Service account JSON"
    prompt_value  GCP_DOCAI_PROJECT   "  GCP project ID"     ""
    prompt_value  GCP_DOCAI_LOCATION  "  GCP region"         "eu"
    prompt_value  GCP_DOCAI_PROCESSOR "  Processor ID"       ""
fi

CNE_VAULT="" CNE_CLIENT_ID="" CNE_TENANT_ID="" CNE_SECRET=""
ask_yesno USE_CNE "Configure Azure Cloud-Native Extraction (Key Vault)?"
if [[ "$USE_CNE" == "y" ]]; then
    prompt_value  CNE_VAULT     "  Key Vault URL"              ""
    prompt_value  CNE_CLIENT_ID "  Service principal client ID" ""
    prompt_value  CNE_TENANT_ID "  Azure tenant ID"             ""
    prompt_secret CNE_SECRET    "  Service principal secret"
fi

prompt_value IMG_ANNOTATION_LLM "Image annotation LLM" "aws-bedrock@anthropic.claude-images"

# 4. LLM providers
section "4 / 7 — LLM providers"
echo -e "  ${DIM}You only need the provider(s) you have access to.${RESET}"
echo
ask_multiselect LLM_PROVIDERS \
    "Which LLM providers do you have access to?" \
    "EPAM DIAL" "Azure OpenAI" "OpenAI" "AWS Bedrock" "Google Gemini" "DeepSeek" "Groq"

DIAL_BASE="https://ai-proxy.lab.epam.com" DIAL_KEY="" DIAL_VER="2023-12-01-preview"
AZ_ENDPOINT="" AZ_KEY="" AZ_VER="2024-02-01"
OPENAI_KEY=""
BEDROCK_REGION="us-east-1" BEDROCK_KEY_ID="" BEDROCK_SECRET=""
GOOGLE_KEY=""
DEEPSEEK_KEY=""
GROQ_KEY=""

if contains "EPAM DIAL" "$LLM_PROVIDERS"; then
    echo; echo -e "  ${BOLD}EPAM DIAL${RESET}"
    prompt_value  DIAL_BASE "  API base URL" "https://ai-proxy.lab.epam.com"
    prompt_secret DIAL_KEY  "  API key"
    prompt_value  DIAL_VER  "  API version"  "2023-12-01-preview"
fi
if contains "Azure OpenAI" "$LLM_PROVIDERS"; then
    echo; echo -e "  ${BOLD}Azure OpenAI${RESET}"
    prompt_value  AZ_ENDPOINT "  API endpoint URL" ""
    prompt_secret AZ_KEY      "  API key"
    prompt_value  AZ_VER      "  API version"      "2024-02-01"
fi
if contains "OpenAI" "$LLM_PROVIDERS"; then
    echo; echo -e "  ${BOLD}OpenAI${RESET}"
    prompt_secret OPENAI_KEY "  API key"
fi
if contains "AWS Bedrock" "$LLM_PROVIDERS"; then
    echo; echo -e "  ${BOLD}AWS Bedrock${RESET}"
    prompt_value  BEDROCK_REGION  "  AWS region"    "us-east-1"
    prompt_value  BEDROCK_KEY_ID  "  Access key ID" ""
    prompt_secret BEDROCK_SECRET  "  Secret access key"
fi
if contains "Google Gemini" "$LLM_PROVIDERS"; then
    echo; echo -e "  ${BOLD}Google Gemini${RESET}"
    prompt_secret GOOGLE_KEY "  API key"
fi
if contains "DeepSeek" "$LLM_PROVIDERS"; then
    echo; echo -e "  ${BOLD}DeepSeek${RESET}"
    prompt_secret DEEPSEEK_KEY "  API key"
fi
if contains "Groq" "$LLM_PROVIDERS"; then
    echo; echo -e "  ${BOLD}Groq${RESET}"
    prompt_secret GROQ_KEY "  API key"
fi

# 5. Storage
section "5 / 7 — Object storage"
echo -e "  ${DIM}'local' uses the bundled MinIO (no credentials needed).${RESET}"
echo
ask_choice STORAGE_BACKEND "Storage backend" \
    "local/MinIO (default)" "Azure Blob Storage" "AWS S3" "GCP Cloud Storage"

AZURE_CONN_STR="" AZURE_CONTAINER=""
S3_REGION="eu-central-1" S3_KEY_ID="" S3_SECRET="" S3_ENDPOINT="" S3_BUCKET=""
GCS_AUTH_KEY="" GCS_BUCKET=""

case "$STORAGE_BACKEND" in
    "Azure Blob Storage")
        echo; echo -e "  ${BOLD}Azure Blob Storage${RESET}"
        prompt_secret AZURE_CONN_STR  "  Connection string"
        prompt_value  AZURE_CONTAINER "  Container name" "" ;;
    "AWS S3")
        echo; echo -e "  ${BOLD}AWS S3${RESET}"
        prompt_value  S3_REGION   "  AWS region"     "eu-central-1"
        prompt_value  S3_KEY_ID   "  Access key ID"  ""
        prompt_secret S3_SECRET   "  Secret access key"
        prompt_value  S3_ENDPOINT "  Endpoint URL (empty for standard AWS S3)" ""
        prompt_value  S3_BUCKET   "  Bucket name"    "" ;;
    "GCP Cloud Storage")
        echo; echo -e "  ${BOLD}GCP Cloud Storage${RESET}"
        prompt_secret GCS_AUTH_KEY "  Service account auth key (JSON)"
        prompt_value  GCS_BUCKET   "  Bucket name" "" ;;
esac

# 6. SMTP
section "6 / 7 — SMTP (optional)"
SMTP_HOST="" SMTP_PORT="587" SMTP_LOGIN="" SMTP_PASSWORD=""
ask_yesno USE_SMTP "Configure SMTP for email invitations?"
if [[ "$USE_SMTP" == "y" ]]; then
    prompt_value  SMTP_HOST     "  SMTP host"            ""
    prompt_value  SMTP_PORT     "  SMTP port"            "587"
    prompt_value  SMTP_LOGIN    "  Login/email"          ""
    prompt_secret SMTP_PASSWORD "  Password"
fi

# 7. Frontend
section "7 / 7 — Frontend cloud integrations (optional)"
GDRIVE_KEY="" GDRIVE_CLIENT_ID="" GDRIVE_SA=""
OD_CLIENT_ID="" OD_SA=""
ask_yesno USE_GDRIVE "Configure Google Drive integration?"
if [[ "$USE_GDRIVE" == "y" ]]; then
    prompt_secret GDRIVE_KEY       "  Google Drive API key"
    prompt_value  GDRIVE_CLIENT_ID "  OAuth client ID"         ""
    prompt_value  GDRIVE_SA        "  Service account email"   ""
fi
ask_yesno USE_ONEDRIVE "Configure OneDrive integration?"
if [[ "$USE_ONEDRIVE" == "y" ]]; then
    prompt_value OD_CLIENT_ID "  Azure app (client) ID" ""
    prompt_value OD_SA        "  Service account email" ""
fi

# ── Write deps.yaml ───────────────────────────────────────────────────────────

OCR_AFR_ENABLED="false"; contains "Azure Form Recognizer" "$OCR_PROVIDERS" && OCR_AFR_ENABLED="true"
OCR_TEXTRACT_ENABLED="false"; contains "AWS Textract" "$OCR_PROVIDERS" && OCR_TEXTRACT_ENABLED="true"
OCR_GCP_ENABLED="false"; contains "GCP Vision" "$OCR_PROVIDERS" && OCR_GCP_ENABLED="true"
OCR_TESSERACT_ENABLED="true"

cat > "$CONFIG" << EOF
# Generated by bin/setup-credentials — edit freely, then run: make apply-config

litellm:
  master_key: $(yq "$LITELLM_MASTER_KEY")
  salt_key: $(yq "$LITELLM_SALT_KEY")

ocr:
  tesseract:
    enabled: ${OCR_TESSERACT_ENABLED}

  azure_form_recognizer:
    enabled: ${OCR_AFR_ENABLED}
    api_url: $(yq "$AFR_URL")
    api_key: $(yq "$AFR_KEY")
    parsing_strategy: ${AFR_STRATEGY}

  aws_textract:
    enabled: ${OCR_TEXTRACT_ENABLED}
    region: $(yq "$TEXTRACT_REGION")
    access_key_id: $(yq "$TEXTRACT_KEY_ID")
    secret_access_key: $(yq "$TEXTRACT_SECRET")
    parsing_strategy: ${TEXTRACT_STRATEGY}
    s3_bucket_name: $(yq "$TEXTRACT_S3_BUCKET")
    s3_endpoint_url: $(yq "$TEXTRACT_S3_ENDPOINT")

  gcp_vision:
    enabled: ${OCR_GCP_ENABLED}
    auth_key: $(yq "$GCP_VISION_KEY")

parsing:
  img_annotation_llm: $(yq "$IMG_ANNOTATION_LLM")
  gcp_docai:
    account_info_json: $(yq "$GCP_DOCAI_JSON")
    project_id: $(yq "$GCP_DOCAI_PROJECT")
    location: $(yq "$GCP_DOCAI_LOCATION")
    processor_id: $(yq "$GCP_DOCAI_PROCESSOR")
  cloud_native_extraction:
    azure_vault_url: $(yq "$CNE_VAULT")
    client_id: $(yq "$CNE_CLIENT_ID")
    tenant_id: $(yq "$CNE_TENANT_ID")
    client_secret: $(yq "$CNE_SECRET")

llm:
  epam_dial:
    api_base: $(yq "$DIAL_BASE")
    api_key: $(yq "$DIAL_KEY")
    api_version: $(yq "$DIAL_VER")
  azure_openai:
    api_endpoint: $(yq "$AZ_ENDPOINT")
    api_key: $(yq "$AZ_KEY")
    api_version: $(yq "$AZ_VER")
  openai:
    api_key: $(yq "$OPENAI_KEY")
  aws_bedrock:
    region: $(yq "$BEDROCK_REGION")
    access_key_id: $(yq "$BEDROCK_KEY_ID")
    secret_access_key: $(yq "$BEDROCK_SECRET")
  google_gemini:
    api_key: $(yq "$GOOGLE_KEY")
  deepseek:
    api_key: $(yq "$DEEPSEEK_KEY")
  groq:
    api_key: $(yq "$GROQ_KEY")

storage:
  backend: $(yq "$STORAGE_BACKEND")
  azure:
    connection_string: $(yq "$AZURE_CONN_STR")
    container_name: $(yq "$AZURE_CONTAINER")
  aws:
    access_key_id: $(yq "$S3_KEY_ID")
    secret_access_key: $(yq "$S3_SECRET")
    region: $(yq "$S3_REGION")
    endpoint_url: $(yq "$S3_ENDPOINT")
    bucket_name: $(yq "$S3_BUCKET")
  gcp:
    auth_key: $(yq "$GCS_AUTH_KEY")
    bucket_name: $(yq "$GCS_BUCKET")

smtp:
  host: $(yq "$SMTP_HOST")
  port: ${SMTP_PORT}
  login: $(yq "$SMTP_LOGIN")
  password: $(yq "$SMTP_PASSWORD")

auth:
  upstream_auth_url: ""
  auth_uri: ""
  base_url: "https://keycloak.cloud-infra.deps.epam.com"
  realm: "dev"
  client_id: "deps-client-dev"
  scope: ""
  certs_endpoint: ""

frontend:
  auth_type: oidc
  base_url: "http://localhost:8000"
  google_drive:
    api_key: $(yq "$GDRIVE_KEY")
    client_id: $(yq "$GDRIVE_CLIENT_ID")
    service_account_email: $(yq "$GDRIVE_SA")
  one_drive:
    client_id: $(yq "$OD_CLIENT_ID")
    service_account_email: $(yq "$OD_SA")

feature_flags:
  auth_enabled: false
  auth_verify_ssl: false
  instrumentation_enabled: false
  semantic_layout_enabled: false
  merge_tables_enabled: false
  litellm_enabled: true
  new_validation_process: true
  gen_ai_key_value_fields: false
EOF

echo
echo -e "${GREEN}${BOLD}✓ deps.yaml written.${RESET}"
echo -e "${DIM}  Review it, then run: make apply-config${RESET}"
echo
