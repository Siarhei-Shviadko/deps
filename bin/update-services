#!/usr/bin/env bash
# Check out the latest first-level services from origin, then nested vendors at
# the SHAs those service commits recorded (not latest vendor HEAD).
#
# GitHub throttles a burst of SSH git connections (the update looks hung).
# One ControlMaster connection is reused for every SSH fetch.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

eval "$(bin/git-protocol env)"

export GIT_TERMINAL_PROMPT=0

SOCK="${TMPDIR:-/tmp}/deps-update-ssh-$$"
cleanup() {
	ssh -o ControlPath="$SOCK" -O exit git@github.com >/dev/null 2>&1 || true
	rm -f "$SOCK"
}
trap cleanup EXIT

if [[ "$DEPS_GIT_PROTOCOL" == ssh ]]; then
	echo "Opening shared SSH connection to GitHub..."
	if ssh -o ControlMaster=yes -o ControlPath="$SOCK" -o ControlPersist=5m \
		-o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
		-fN git@github.com; then
		export GIT_SSH_COMMAND="ssh -o ControlPath=${SOCK} -o ConnectTimeout=15 -o ServerAliveInterval=30"
		echo "SSH multiplexing enabled."
	else
		echo "Warning: could not open SSH master; each fetch will open a new connection (GitHub may throttle)."
		export GIT_SSH_COMMAND="ssh -o ConnectTimeout=15"
	fi
else
	echo "Using HTTPS for GitHub clones (no SSH multiplexing)."
fi

echo
echo "Updating first-level services from origin..."
git -c submodule.fetchJobs=2 submodule update --init --remote

echo
echo "Updating nested vendors to recorded SHAs..."
git submodule foreach '
	echo "  $displaypath"
	git -c submodule.fetchJobs=2 submodule update --init --recursive
'

echo
echo "Done."
